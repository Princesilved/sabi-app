# --- Convex ---
# Get from running `npx convex dev` for the first time
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# --- Clerk ---
# https://dashboard.clerk.com/ → Your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Used by convex/auth.config.ts — the JWT issuer URL from Clerk
# In Clerk dashboard: JWT Templates → Create "convex" template
# Then copy the Issuer URL from that template
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Optional: clerk webhook signing secret (for syncing user deletions)
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Sabi auth redirects (paths) ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- AI providers (server-side only, set inside Convex) ---
# Gemini is the PRIMARY engine (free, also reads receipts). Anthropic is the BACKUP.
# At minimum set GEMINI_API_KEY so the assistant + receipt scanning work.
# Set via: npx convex env set GEMINI_API_KEY AIzaSy...
# Optional backup: npx convex env set ANTHROPIC_API_KEY sk-ant-xxxxx
# DO NOT put them here — Convex actions read from Convex env, not Next.js env
